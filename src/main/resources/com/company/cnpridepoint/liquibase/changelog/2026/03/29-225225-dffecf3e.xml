<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="cn-pride-point">
        <createTable tableName="ACTIVITY_SCHEDULE">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACTIVITY_SCHEDULE"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="PROGRAM_ID" type="UUID"/>
            <column name="ACTIVITY_ID" type="UUID"/>
            <column name="START_DATE" type="DATETIME"/>
            <column name="END_DATE" type="DATETIME"/>
            <column name="STATUS" type="VARCHAR(255)"/>
            <column name="NOTES" type="CLOB"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="cn-pride-point">
        <createIndex indexName="IDX_ACTIVITY_SCHEDULE_ACTIVITY" tableName="ACTIVITY_SCHEDULE">
            <column name="ACTIVITY_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="ACTIVITY_ID" baseTableName="ACTIVITY_SCHEDULE"
                                 constraintName="FK_ACTIVITY_SCHEDULE_ON_ACTIVITY" referencedColumnNames="ID"
                                 referencedTableName="ACTIVITY"/>
    </changeSet>
    <changeSet id="3" author="cn-pride-point">
        <createIndex indexName="IDX_ACTIVITY_SCHEDULE_PROGRAM" tableName="ACTIVITY_SCHEDULE">
            <column name="PROGRAM_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="PROGRAM_ID" baseTableName="ACTIVITY_SCHEDULE"
                                 constraintName="FK_ACTIVITY_SCHEDULE_ON_PROGRAM" referencedColumnNames="ID"
                                 referencedTableName="PROGRAM"/>
    </changeSet>
    <changeSet id="4" author="cn-pride-point">
        <dropColumn columnName="END_DATE" tableName="activity"/>

        <dropColumn columnName="START_DATE" tableName="activity"/>
    </changeSet>
</databaseChangeLog>