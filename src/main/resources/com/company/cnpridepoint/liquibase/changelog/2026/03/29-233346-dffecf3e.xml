<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="cn-pride-point">
        <dropForeignKeyConstraint baseTableName="activity_attendance"
                                  constraintName="FK_ACTIVITY_ATTENDANCE_ON_ACTIVITY"/>
    </changeSet>
    <changeSet id="2" author="cn-pride-point">
        <dropForeignKeyConstraint baseTableName="activity_attendance"
                                  constraintName="FK_ACTIVITY_ATTENDANCE_ON_PROGRAM"/>
    </changeSet>
    <changeSet id="3" author="cn-pride-point">
        <addColumn tableName="ACTIVITY_ATTENDANCE">
            <column name="ACTIVITY_SCHEDULE_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="4" author="cn-pride-point">
        <createIndex indexName="IDX_ACTIVITY_ATTENDANCE_ACTIVITY_SCHEDULE" tableName="ACTIVITY_ATTENDANCE">
            <column name="ACTIVITY_SCHEDULE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="ACTIVITY_SCHEDULE_ID" baseTableName="ACTIVITY_ATTENDANCE"
                                 constraintName="FK_ACTIVITY_ATTENDANCE_ON_ACTIVITY_SCHEDULE" referencedColumnNames="ID"
                                 referencedTableName="ACTIVITY_SCHEDULE"/>
    </changeSet>
    <changeSet id="5" author="cn-pride-point">
        <dropColumn columnName="ACTIVITY_ID" tableName="activity_attendance"/>

        <dropColumn columnName="PROGRAM_ID" tableName="activity_attendance"/>
    </changeSet>
</databaseChangeLog>