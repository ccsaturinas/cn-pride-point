<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="cn-pride-point">
        <dropForeignKeyConstraint baseTableName="activity" constraintName="FK_ACTIVITY_ON_PROGRAM"/>
    </changeSet>
    <changeSet id="2" author="cn-pride-point">
        <addColumn tableName="ACTIVITY_ATTENDANCE">
            <column name="PROGRAM_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="3" author="cn-pride-point">
        <createIndex indexName="IDX_ACTIVITY_ATTENDANCE_PROGRAM" tableName="ACTIVITY_ATTENDANCE">
            <column name="PROGRAM_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="PROGRAM_ID" baseTableName="ACTIVITY_ATTENDANCE"
                                 constraintName="FK_ACTIVITY_ATTENDANCE_ON_PROGRAM" referencedColumnNames="ID"
                                 referencedTableName="PROGRAM"/>
    </changeSet>
    <changeSet id="4" author="cn-pride-point">
        <dropColumn columnName="PROGRAM_ID" tableName="activity"/>
    </changeSet>
</databaseChangeLog>