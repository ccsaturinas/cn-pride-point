<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://activityDetailView.title"
      focusComponent="form">
    <data>
        <instance id="activityDc"
                  class="com.company.cnpridepoint.entity.Activity">
            <fetchPlan extends="_base">
            </fetchPlan>
            <loader id="activityDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="activityDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="nameField" property="name"/>
            <hbox id="activityTypeBox" spacing="true" margin="false" padding="false">
                <select id="activityTypeField" width="100%"
                        label="msg://com.company.cnpridepoint.entity/ActivityType"
                        dataContainer="activityDc" property="activityType"/>
                <select id="statusField" width="100%"
                        label="msg://com.company.cnpridepoint.entity/Activity.status"
                        dataContainer="activityDc" property="status"/>
            </hbox>
            <dateTimePicker id="startDateField" property="startDate"/>
            <dateTimePicker id="endDateField" property="endDate"/>
            <textArea id="detailsField" property="details"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
