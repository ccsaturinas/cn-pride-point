<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://attendeeDetailView.title"
      focusComponent="form">
    <data>
        <instance id="attendeeDc"
                  class="com.company.cnpridepoint.entity.Attendee">
            <fetchPlan extends="_base">
                <property name="yearLevel" fetchPlan="_base"/>
                <property name="section" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="attendeeDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="attendeeDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="codeField" property="code"/>
            <textField id="nameField" property="name"/>
            <datePicker id="birthdateField" property="birthdate"/>
            <select id="genderField" property="gender"/>
            <select id="attendeeTypeField" property="attendeeType"/>
            <select id="shirtSizeField" property="shirtSize"/>
            <entityPicker id="yearLevelField" property="yearLevel">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="sectionField" property="section">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textField id="displayNameField" property="displayName"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
