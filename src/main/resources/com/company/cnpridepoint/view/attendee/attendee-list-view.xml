<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://attendeeListView.title"
      focusComponent="attendeesDataGrid">
    <data>
        <collection id="attendeesDc"
                    class="com.company.cnpridepoint.entity.Attendee">
            <fetchPlan extends="_base">
                <property name="yearLevel" fetchPlan="_base"/>
                <property name="section" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="attendeesDl" readOnly="true">
                <query>
                    <![CDATA[select e from Attendee e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout spacing="false">
        <genericFilter id="genericFilter"
                       dataLoader="attendeesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="attendeesDataGrid.createAction"/>
                <button id="editButton" action="attendeesDataGrid.editAction"/>
                <button id="excelExportButton" action="attendeesDataGrid.excelExportAction"/>
                <button id="removeButton" action="attendeesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="attendeesDl" itemsPerPageVisible="true"/>
                <gridColumnVisibility dataGrid="attendeesDataGrid" icon="vaadin:cog-o" themeNames="icon"/>
            </endSlot>
        </hbox>
        <dataGrid id="attendeesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="attendeesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="excelExportAction" type="grdexp_excelExport"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="profilePic" header="Profile" autoWidth="true"/>
                <column property="displayName" header="Attendee" autoWidth="true"/>
                <column property="code" autoWidth="true" visible="false"/>
                <column property="firstName" autoWidth="true" visible="false"/>
                <column property="lastName" autoWidth="true" visible="false"/>
                <column property="middleName" autoWidth="true" visible="false"/>
                <column property="birthdate" autoWidth="true"/>
                <column property="age" autoWidth="true"/>
                <column property="gender" autoWidth="true"/>
                <column property="attendeeType" autoWidth="true"/>
                <column property="shirtSize" autoWidth="true"/>
                <column property="yearLevel" autoWidth="true"/>
                <column property="section" autoWidth="true"/>
                <column property="status" autoWidth="true"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
