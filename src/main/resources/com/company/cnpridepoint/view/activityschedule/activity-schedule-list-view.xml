<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://activityScheduleListView.title"
      focusComponent="activitySchedulesDataGrid">
    <data>
        <collection id="activitySchedulesDc"
                    class="com.company.cnpridepoint.entity.ActivitySchedule">
            <fetchPlan extends="_base"/>
            <loader id="activitySchedulesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="activitySchedulesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="activitySchedulesDataGrid.createAction"/>
                <button id="editButton" action="activitySchedulesDataGrid.editAction"/>
                <button id="excelExportButton" action="activitySchedulesDataGrid.excelExportAction"/>
                <button id="removeButton" action="activitySchedulesDataGrid.removeAction"/>
                <fileUploadField id="importExcel" acceptedFileTypes=".xlsx"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="activitySchedulesDl"/>
                <gridColumnVisibility dataGrid="activitySchedulesDataGrid" icon="vaadin:cog-o" themeNames="icon"/>
            </endSlot>
        </hbox>
        <dataGrid id="activitySchedulesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="activitySchedulesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="excelExportAction" type="grdexp_excelExport"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="program"/>
                <column property="activity"/>
                <column property="startDate"/>
                <column property="endDate"/>
                <column property="status"/>
                <column property="notes"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
